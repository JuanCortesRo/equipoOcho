<?xml version="1.0" encoding="utf-8"?>
<!-- HU 1.0 – Ventana Login. Sin toolbar y fondo gris oscuro (C1). -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_gray">

        <!-- KAN-23 (HU 1.0 C2): cabeza del perro arriba a la derecha.
             - layout_width="0dp" + layout_constraintWidth_percent: el ancho es una fracción (35%) del
               padre, así la imagen escala en cualquier tamaño de pantalla (en vez de dp fijos).
             - adjustViewBounds: la altura sigue la proporción de la imagen, sin deformarla.
             - importantForAccessibility="no": es decorativa, TalkBack no debe anunciarla. -->
        <ImageView
            android:id="@+id/imgDogHead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/img_dog_head"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.35" />

        <!-- KAN-24 (HU 1.0 C3): titulo "DogApp" centrado debajo de la imagen.
             - fontFamily="@font/poppins_bold": fuente en res/font. Ya es la variante Bold, por eso
               NO se usa textStyle="bold" (evita negrita falsa doble).
             - textSize en sp (no dp): respeta el tamano de letra que el usuario configuro (accesibilidad).
             - text="@string/dog_app_title": el texto vive en strings.xml, no escrito a mano.
             - Blanco sobre dark_gray (#263238): contraste alto.
             - Start/End anclados a imgDogHead (no al padre): el titulo se centra respecto a la IMAGEN. -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/dog_app_title"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            app:layout_constraintEnd_toEndOf="@id/imgDogHead"
            app:layout_constraintStart_toStartOf="@id/imgDogHead"
            app:layout_constraintTop_toBottomOf="@id/imgDogHead" />

        <!-- KAN-25 (HU 1.0 C4): animacion Lottie de huella, abajo al centro.
             - lottie_rawRes: el JSON vive en res/raw (fingerprint_scan.json).
             - lottie_autoPlay + lottie_loop: arranca sola y se repite sin parar.
             - 0dp + layout_constraintWidth_percent + dimensionRatio 1:1: cuadrada y responsive.
             - clickable/focusable + contentDescription: es el elemento que se toca para abrir la
               biometria (KAN-26), asi que TalkBack debe anunciarlo y tiene tamano tactil > 48dp. -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieFingerprint"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="48dp"
            android:clickable="true"
            android:contentDescription="@string/login_fingerprint_description"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.4"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/fingerprint_scan" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
