<?xml version="1.0" encoding="utf-8"?>
<!-- RECURSO COMPARTIDO: estilos de los formularios y del botón principal. -->
<resources>

    <!--
      Campo de texto con contorno: hint gris que sube al recibir el foco y borde morado con foco.
      Es el estilo por defecto de todo TextInputLayout (ver textInputStyle en themes.xml), así que no
      hace falta declararlo en cada campo. Sirve igual para un TextInputEditText o un
      MaterialAutoCompleteTextView dentro del TextInputLayout.
    -->
    <style name="Widget.DogApp.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.DogApp.TextInputLayout</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="android:textColorHint">@color/hint_gray</item>
        <item name="hintTextColor">@color/hint_gray</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
    </style>

    <!--
      Estilo de los campos internos del TextInputLayout. Material solo da el padding del contorno a
      TextInputEditText; esto se lo da también a MaterialAutoCompleteTextView (sin flecha desplegable).
    -->
    <style name="ThemeOverlay.DogApp.TextInputLayout" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">
        <item name="autoCompleteTextViewStyle">@style/Widget.Material3.AutoCompleteTextView.OutlinedBox</item>
    </style>

    <!--
      Botón principal: rosado con bordes redondeados e ícono a la izquierda (app:icon).
      Deshabilitado se ve atenuado. Para que el texto pase a bold al habilitarse, se usa con
      ui.common.PrimaryButton:
        <com.equipoocho.dogapp.ui.common.PrimaryButton
            style="@style/Widget.DogApp.Button.Primary"
            android:text="@string/save_appointment"
            app:icon="@drawable/ic_save" ... />
    -->
    <style name="Widget.DogApp.Button.Primary" parent="Widget.Material3.Button.Icon">
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="android:textColor">@color/button_primary_content</item>
        <item name="iconTint">@color/button_primary_content</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
</resources>
